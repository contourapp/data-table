{
  "name": "@contourapp/data-table",
  "version": "0.1.0",
  "description": "Virtualized, filterable data table for React built on Mantine and TanStack Table v9",
  "keywords": [
    "react",
    "table",
    "data-table",
    "datagrid",
    "mantine",
    "tanstack-table",
    "filter",
    "virtualized",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/contourapp/data-table#readme",
  "bugs": {
    "url": "https://github.com/contourapp/data-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contourapp/data-table.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "clean": "rm -rf dist",
    "prepack": "yarn clean && yarn build",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@tabler/icons-react": "^3.0.0",
    "@tanstack/react-table": "^9.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "dayjs": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dayjs": "^1.11.23",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.17.1"
}
